# ====================================
# .htaccess - Performance Optimized
# دارالقرآن حاج ملا علی عقیلی
# ====================================

# 1. Enable Compression (بهینه شده)
<IfModule mod_deflate.c>
    # فشرده‌سازی HTML, CSS, JavaScript
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    
    # فشرده‌سازی فونت‌ها
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE application/font-woff2
</IfModule>

# 2. Browser Caching (بهینه شده)
<IfModule mod_expires.c>
    ExpiresActive On
    
    # تصاویر و آیکون‌ها (1 سال)
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    
    # فونت‌ها (1 سال)
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    
    # CSS و JavaScript (1 سال - چون minified است)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    
    # HTML (1 ساعت)
    ExpiresByType text/html "access plus 1 hour"
    
    # Default
    ExpiresDefault "access plus 1 month"
</IfModule>

# 3. Cache Control Headers (جدید)
<IfModule mod_headers.c>
    # CSS و JavaScript - immutable برای عدم revalidation
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # فونت‌ها - CORS برای cross-origin
    <FilesMatch "\.(woff2|woff|ttf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
    
    # تصاویر و SVG
    <FilesMatch "\.(jpg|jpeg|png|svg|webp|ico)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
    
    # HTML - کش کوتاه‌تر
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
</IfModule>

# 4. Security Headers (بهینه شده)
<IfModule mod_headers.c>
    # جلوگیری از MIME sniffing
    Header set X-Content-Type-Options "nosniff"
    
    # محافظت در برابر clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    
    # فعال‌سازی XSS protection
    Header set X-XSS-Protection "1; mode=block"
    
    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Permissions Policy (جدید)
    Header set Permissions-Policy "geolocation=(self), microphone=(), camera=()"
</IfModule>

# 5. Force HTTPS (برای production uncomment کنید)
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 6. Remove www (برای production uncomment کنید)
# RewriteEngine On
# RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
# RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# 7. Custom Error Pages
# ErrorDocument 404 /404.html
# ErrorDocument 500 /500.html

# 8. UTF-8 Encoding (جدید)
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
    AddCharset UTF-8 .html .css .js .xml .json .txt
</IfModule>

# 9. Disable Directory Browsing (امنیت)
Options -Indexes

# 10. File Protection (امنیت)
<FilesMatch "\.(env|log|ini|config|git)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# 11. ETag Optimization (جدید)
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None

# 12. Remove Server Signature (امنیت)
ServerSignature Off

# ====================================
# پایان تنظیمات
# Version: 2.0 (Optimized)
# ====================================
